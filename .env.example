# Copy to .env for local dev. On Azure frontend App Service, set the same
# names under Configuration → Application settings (then Restart).

# Backend API proxy target (server.js / Vite proxy)
BACKEND_URL=http://localhost:5000

# Microsoft Azure AD / OneDrive (public SPA client id — safe in browser)
VITE_AZURE_CLIENT_ID=
VITE_AZURE_TENANT_ID=

# Google OAuth / Google Drive (public SPA client id)
# Add your prod origin under Authorized JavaScript origins in Google Cloud Console
VITE_GOOGLE_CLIENT_ID=
